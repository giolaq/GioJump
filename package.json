{
  "name": "gio-jump",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && node scripts/sync-android.mjs",
    "android:apk": "npm run android:apk:play",
    "android:apk:play": "npm run android:sync && cd android && ./gradlew assemblePlayDebug",
    "android:apk:amazon": "npm run android:sync && cd android && ./gradlew assembleAmazonDebug",
    "vega:install": "npm --prefix vega ci",
    "vega:sync": "npm run build && node scripts/sync-vega.mjs",
    "vega:doctor": "cd vega && node ../scripts/vega-cli.mjs project doctor",
    "vega:build": "npm run vega:sync && npm --prefix vega run build:release",
    "vega:build:debug": "npm run vega:sync && npm --prefix vega run build:debug",
    "vega:run": "node scripts/run-vega.mjs"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "pngjs": "^7.0.0",
    "vite": "^6.1.0"
  }
}
